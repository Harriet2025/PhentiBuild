# PhentiBuild Django backend — environment settings.
# Copy to ".env" for local development. On Coolify, enter these in the
# application's "Environment Variables" screen instead (never commit .env).

# development | production
APP_ENV=development
DJANGO_DEBUG=true
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated. Production: your API domain, e.g. api.phentibuild.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins allowed to send logged-in POST/PUT/DELETE.
# Production: your Vercel URL(s), e.g. https://phentibuild.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL / MariaDB (MariaDB 10.5+ or MySQL 8.0.11+ — Django requirement)
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=phentibuild
DB_USER=phentibuild_app
DB_PASSWORD=
# Seconds to keep a DB connection open between requests
DB_CONN_MAX_AGE=60

# Cookies are HTTPS-only automatically when DJANGO_DEBUG=false.
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=0

TIME_ZONE=Africa/Accra
LOG_LEVEL=INFO

# Rate limits (DRF format: N/second|minute|hour|day)
LOGIN_THROTTLE_RATE=10/min
REGISTER_THROTTLE_RATE=20/hour
CONTACT_THROTTLE_RATE=10/hour

# Optional AI roof generation (any OpenAI-compatible Chat Completions URL).
# Leave blank to keep the honest "not connected" state.
# Sign in with Google: OAuth 2.0 Client ID (Web application) from Google Cloud Console.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Camera Scanner measuring: Anthropic API key from console.anthropic.com.
# Server-only secret. Empty = the scanner uses manual entry.
ANTHROPIC_API_KEY=
# VISION_MODEL=claude-opus-5-5
# VISION_THROTTLE_RATE=30/hour

ROOF_AI_API_URL=
ROOF_AI_API_KEY=
ROOF_AI_MODEL=
