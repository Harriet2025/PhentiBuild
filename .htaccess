# PhentiBuild - project root
# Block direct access to dotfiles (.env holds real DB credentials once
# configured for a non-local environment) without affecting anything
# else the app serves from here.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Composer's own files — no reason to ever serve these directly.
<FilesMatch "^composer\.(json|lock|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
