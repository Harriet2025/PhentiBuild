# PhentiBuild environment configuration
# Copy this file to ".env" (same folder) and adjust for your machine.
# ".env" itself is git-ignored — never commit real credentials.

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=phentibuild
DB_USER=root
DB_PASS=

# development | production — controls whether PHP errors are ever
# rendered to the screen. The JSON API always returns clean error
# responses regardless of this setting.
APP_ENV=development

BASE_URL=http://localhost/PhentiBuild

# Optional: connects the AI Roof Generation service (Roof Studio ->
# "Generate with AI") to a real OpenAI-compatible Chat Completions
# endpoint. Leave all three blank to keep the honest "not connected"
# state — the app will never fabricate a generated roof design without
# these set. See backend/services/RoofAIService.php.
ROOF_AI_API_URL=
ROOF_AI_API_KEY=
ROOF_AI_MODEL=
